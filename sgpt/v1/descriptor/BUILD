# The descriptor set and its Go embed shim, mirrored into genproto so plain
# `go build` works without please.
genrule(
    name = "srcs",
    srcs = ["//sgpt/v1:descriptor_set"],
    outs = [
        "descriptor_set.bin",
        "descriptor_set.go",
    ],
    cmd = """
cp $SRCS descriptor_set.bin
cat > descriptor_set.go <<'EOF'
// Code generated by //sgpt/v1/descriptor:srcs. DO NOT EDIT.

// Package descriptor embeds the sgpt/v1 descriptor set.
package descriptor

import _ "embed"

// Set is the serialized FileDescriptorSet of sgpt/v1 and its imports,
// compiled with source info.
//
//go:embed descriptor_set.bin
var Set []byte
EOF
""",
    labels = [
        "codegen",
        "copy_generated_code::genproto",
    ],
)

go_library(
    name = "descriptor",
    srcs = [":srcs"],
    import_path = "github.com/malonaz/sgpt/genproto/sgpt/v1/descriptor",
    resources = [":srcs"],
    visibility = ["PUBLIC"],
)
