go_library(
    name = "widget",
    srcs = [
        "agent_panel.go",
        "agents.go",
        "confirm.go",
        "document.go",
        "filter.go",
        "info.go",
        "input.go",
        "picker.go",
        "statusbar.go",
        "tab_bar.go",
    ],
    visibility = ["//..."],
    deps = [
        "//cli/tui/editor",
        "//cli/tui/format",
        "//cli/tui/keymap",
        "//cli/tui/styles",
        "//internal/history",
        "//internal/markdown",
        "//internal/session",
        "//internal/tool/agent",
        "//sgpt/v1",
        "//third_party/go:charm.land__bubbles__v2__key",
        "//third_party/go:charm.land__bubbles__v2__textarea",
        "//third_party/go:charm.land__bubbles__v2__viewport",
        "//third_party/go:charm.land__bubbletea__v2",
        "//third_party/go:charm.land__lipgloss__v2",
        "//third_party/go:github.com__charmbracelet__x__ansi",
        "//third_party/proto:malonaz__core__genproto__ai__v1",
    ],
)

